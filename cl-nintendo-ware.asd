(asdf:defsystem #:cl-nintendo-ware
  :description "Binstruct-based NintendoWare C/F sound file readers; no playback."
  :version "0.1.0"
  :depends-on (#:alexandria #:binstruct #:parsonic #:flexi-streams)
  :in-order-to ((asdf:test-op (asdf:test-op #:cl-nintendo-ware/test)))
  :components ((:file "package")
               (:file "binary" :depends-on ("package"))
               (:file "common" :depends-on ("binary"))
               (:file "reference" :depends-on ("binary"))
               (:file "file" :depends-on ("reference"))
               (:file "section" :depends-on ("file"))
               (:module "sound"
                :depends-on ("common" "section")
                :components ((:file "sound")
                             (:file "xseq" :depends-on ("sound"))
                             (:file "xwav" :depends-on ("sound"))
                             (:file "xwar" :depends-on ("xwav"))
                             (:file "xbnk" :depends-on ("sound"))
                             (:file "xwsd" :depends-on ("xbnk"))
                             (:file "xstm" :depends-on ("xwav"))
                             (:file "xsar" :depends-on ("sound"))
                             (:file "xgrp" :depends-on ("sound"))))))

(asdf:defsystem #:cl-nintendo-ware/test
  :depends-on (#:cl-nintendo-ware)
  :components ((:static-file "test/data/mset.bcsar")
               (:static-file "test/data/TigerSound.bcsar")
               (:static-file "test/data/menu.bcsar")
               (:file "test/sequence")
               (:file "test/endian-fixtures" :depends-on ("test/sequence"))
               (:file "test/formats" :depends-on ("test/endian-fixtures"))
               (:file "test/archives" :depends-on ("test/formats"))
               (:file "test/endian-readers" :depends-on ("test/archives"))
               (:file "test/pmee" :depends-on ("test/sequence")))
  :perform (asdf:test-op (operation component)
             (declare (ignore operation component))
             (uiop:symbol-call '#:cl-nintendo-ware.test '#:run-tests)
             (uiop:symbol-call '#:cl-nintendo-ware.test '#:run-format-tests)
             (uiop:symbol-call '#:cl-nintendo-ware.test '#:run-archive-tests)
             (uiop:symbol-call '#:cl-nintendo-ware.test '#:run-endian-tests)
             (uiop:symbol-call '#:cl-nintendo-ware.test '#:run-pmee-tests)))
