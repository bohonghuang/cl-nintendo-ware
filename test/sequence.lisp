(defun emit-octets (output octets)
  (write-sequence (coerce octets '(simple-array (unsigned-byte 8) (*))) output))

(defun sequence-fixture (body &key (padded t) (label-offset 0))
  (let* ((data-size (if padded 32 (+ 8 (length body))))
         (references (vector (cl-nintendo-ware.test::make-sized-reference :type #x5000 :offset 64 :size data-size)
                             (cl-nintendo-ware.test::make-sized-reference :type #x5001 :offset 96 :size 64)))
         (header (cl-nintendo-ware.test::make-header-record :magic (coerce (fixture-magic "CSEQ") 'simple-base-string) :bom #xfeff :header-size 64
                                             :version (fixture-version #x01020300) :file-size 160 :block-count 2
                                             :references references)))
    (flexi-streams:with-output-to-sequence (output)
      (emit-octets output (encode-record 'header-record header))
      (emit-octets output (make-array 20 :initial-element 0))
      (emit-octets output (encode-record 'block-record (cl-nintendo-ware.test::make-block-record :magic #.(coerce "DATA" 'simple-base-string) :size data-size)))
      (emit-octets output body)
      (emit-octets output (make-array (- 24 (length body)) :initial-element 0))
      (emit-octets output (encode-record 'block-record (cl-nintendo-ware.test::make-block-record :magic #.(coerce "LABL" 'simple-base-string) :size 64)))
      (emit-octets output (encode-record 'reference-table (cl-nintendo-ware.test::make-reference-table :count 1
                                             :entries (vector (cl-nintendo-ware.test::make-reference :type #x5100 :offset 12)))))
      (emit-octets output (encode-record 'xseq-label-entry (cl-nintendo-ware.test::make-xseq-label-entry :target (cl-nintendo-ware.test::make-reference :type #x1f00 :offset label-offset)
                                                                :length 5 :name #.(coerce "start" 'simple-base-string))))
      (emit-octets output (make-array 26 :initial-element 0)))))

(defmacro rejects (condition &body body)
  `(assert (handler-case (progn ,@body nil) (,condition () t))))

(defun xwav-encoded-size (codec sample-count)
  "The number of encoded bytes for one CWAV channel, excluding alignment."
  (ecase codec
    (0 sample-count)
    (1 (* 2 sample-count))
    (2 (* 8 (ceiling sample-count 14)))
    (3 (ceiling sample-count 2))))

(defun run-tests ()
  ;; Reloading the declared package after the library must not conflict with
  ;; undeclared exports. Continue exercising the same reader symbols below.
  (let ((definition (asdf:system-relative-pathname :cl-nintendo-ware #P"package.lisp")))
    (handler-bind ((warning #'error))
      (loop repeat 2 do (load definition :verbose nil :print nil))))
  (let* ((bytes (sequence-fixture #(60 100 #x81 0 #xe1 1 #x2c #xa0 #xc3 #xff #xf4 0 12 #xf0 #x80 3 #xff #xfe #xff)))
         (sequence (nintendo-ware::read-file 'nintendo-ware::xseq bytes))
         (events (nintendo-ware::xseq-events sequence))
         (note (aref events 0)) (tempo (aref events 1))
         (random (aref events 2)) (extended (aref events 3))
         (label (aref (nintendo-ware::xseq-labels-entries (nintendo-ware::xseq-labels sequence)) 0)))
    (assert (= #x01020300 (nintendo-ware::nintendo-ware-file-header-version (nintendo-ware::xseq-header sequence))))
    (assert (string= "start" (nintendo-ware::xseq-label-entry-name label)))
    (assert (= 0 (nintendo-ware::xseq-label-entry-index label)))
    (assert (typep note 'nintendo-ware::xseq-event-note))
    (assert (= 60 (nintendo-ware::xseq-event-note-key note)))
    (assert (= 100 (nintendo-ware::xseq-event-note-velocity note)))
    (assert (= 128 (nintendo-ware::xseq-event-note-duration note)))
    (assert (= 300 (nintendo-ware::xseq-event-tempo-value tempo)))
    (assert (= -12 (nintendo-ware::xseq-event-random-min random)))
    (assert (= 12 (nintendo-ware::xseq-event-random-max random)))
    (assert (typep (nintendo-ware::xseq-event-random-sub-event random) 'nintendo-ware::xseq-event-transpose))
    (assert (typep extended 'nintendo-ware::xseq-event-set-variable))
    (assert (= 3 (nintendo-ware::xseq-event-set-variable-variable extended)))
    (assert (= -2 (nintendo-ware::xseq-event-set-variable-value extended)))
    (assert (typep (aref events 4) 'nintendo-ware::xseq-event-finish))
    (assert (equalp sequence (nintendo-ware::read-file 'nintendo-ware::xseq (flexi-streams:make-in-memory-input-stream bytes))))
    (rejects binstruct::deserialize-error (nintendo-ware::read-file 'nintendo-ware::xwav bytes))
    (rejects binstruct::deserialize-error (nintendo-ware::read-file 'nintendo-ware::xseq (sequence-fixture #(#xff) :label-offset 24))))
  ;; Enum operands remain semantic under ordinary and nested event readers.
  (let ((events (nintendo-ware::xseq-events
                 (nintendo-ware::read-file 'nintendo-ware::xseq
                   (sequence-fixture #(#xcc 2 #xbe 4 #xdd 3 #xc7 0 #xc8 1
                                       #xa2 #xf0 #xa4 1 #xf0 #xa6 3 #xff))))))
    (assert (eq 'nintendo-ware::pan (nintendo-ware::xseq-event-mod-type-value (aref events 0))))
    (assert (eq 'nintendo-ware::random (nintendo-ware::xseq-event-mod-curve-value (aref events 1))))
    (assert (eq 'nintendo-ware::stop (nintendo-ware::xseq-event-mute-value (aref events 2))))
    (assert (null (nintendo-ware::xseq-event-note-wait-value (aref events 3))))
    (assert (eq t (nintendo-ware::xseq-event-tie-value (aref events 4))))
    (assert (eq 'nintendo-ware::volume
                (nintendo-ware::xseq-event-mod2-type-value
                  (nintendo-ware::xseq-event-if-sub-event (aref events 5)))))
    (assert (eq 'nintendo-ware::rectangular (nintendo-ware::xseq-event-mod3-curve-value (aref events 6)))))
  (dolist (case '((#(0) 0) (#(#x7f) 127) (#(#x81 0) 128) (#(#xff #x7f) 16383)
                  (#(#x81 #x80 0) 16384) (#(#xff #xff #x7f) 2097151) (#(#xff #xff #xff #x7f) 268435455)
                  (#(#x81 #x80 #x80 #x80 0) 268435456) (#(#x8f #xff #xff #xff #x7f) 4294967295)))
    (destructuring-bind (encoded expected) case
      (let ((events (nintendo-ware::xseq-events
                     (nintendo-ware::read-file 'nintendo-ware::xseq (sequence-fixture (concatenate 'vector #(#x80) encoded #(#xff)))))))
        (assert (= expected (nintendo-ware::xseq-event-wait-value (aref events 0))))
        (assert (typep (aref events 1) 'nintendo-ware::xseq-event-finish)))))
  (dolist (case '((#(#xa0 60 100 #xff #xf4 0 12 #xff) nintendo-ware::xseq-event-random nintendo-ware::xseq-event-note)
                  (#(#xa1 #xf0 #x80 3 2 #xff) nintendo-ware::xseq-event-variable nintendo-ware::xseq-event-set-variable)
                  (#(#xa2 #xc1 90 #xff) nintendo-ware::xseq-event-if nintendo-ware::xseq-event-volume)
                  (#(#xa3 60 100 1 0 24 #xff) nintendo-ware::xseq-event-time nintendo-ware::xseq-event-note)
                  (#(#xa4 #xe1 0 120 0 1 0 2 #xff) nintendo-ware::xseq-event-time-random nintendo-ware::xseq-event-tempo)
                  (#(#xa5 #xc0 64 4 #xff) nintendo-ware::xseq-event-time-variable nintendo-ware::xseq-event-pan)))
    (destructuring-bind (body type child-type) case
      (let* ((events (nintendo-ware::xseq-events (nintendo-ware::read-file 'nintendo-ware::xseq (sequence-fixture body))))
             (event (aref events 0)))
        (assert (typep event type))
        (assert (typep (nintendo-ware::xseq-event-child event) child-type))
        (assert (typep (aref events 1) 'nintendo-ware::xseq-event-finish)))))
  ;; Byte targets 11 and 10 become event indices 3 and 2, including nested control flow.
  (let* ((sequence (nintendo-ware::read-file 'nintendo-ware::xseq
                     (sequence-fixture #(136 2 0 0 11 162 138 0 0 11 255 137 0 0 10) :label-offset 11)))
         (events (nintendo-ware::xseq-events sequence))
         (label (aref (nintendo-ware::xseq-labels-entries (nintendo-ware::xseq-labels sequence)) 0)))
    (assert (= 3 (nintendo-ware::xseq-label-entry-index label)))
    (assert (= 3 (nintendo-ware::xseq-event-open-track-index (aref events 0))))
    (assert (= 3 (nintendo-ware::xseq-event-call-index (nintendo-ware::xseq-event-if-sub-event (aref events 1)))))
    (assert (= 2 (nintendo-ware::xseq-event-jump-index (aref events 3)))))
  (let ((events (nintendo-ware::xseq-events
                  (nintendo-ware::read-file 'nintendo-ware::xseq (sequence-fixture #(137 0 0 0))))))
    (assert (= 0 (nintendo-ware::xseq-event-jump-index (aref events 0)))))
  (dolist (body '(#(137 0 0 1) #(60 100 129) #(128 128 128 128 128) #(130)))
    (rejects binstruct::deserialize-error
      (nintendo-ware::read-file 'nintendo-ware::xseq (sequence-fixture body :padded nil))))
  (format t "Typed SEQ events, embedded partials and indexed control flow passed.~%"))
