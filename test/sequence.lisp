(defun emit-octets (output octets)
  (write-sequence (coerce octets '(simple-array (unsigned-byte 8) (*))) output))

(defun sequence-fixture (body &key (padded t) (label-offset 0) (data-offset 64) (header-size 64))
  (let* ((data-size (if padded 32 (+ 8 (length body))))
         (references (vector (cl-nintendo-ware.test::make-sized-reference :type #x5000 :offset data-offset :size data-size)
                             (cl-nintendo-ware.test::make-sized-reference :type #x5001 :offset 96 :size 64)))
         (header (cl-nintendo-ware.test::make-header-record :magic (coerce (fixture-magic "CSEQ") 'simple-base-string) :bom #xfeff :header-size header-size
                                             :version (fixture-version #x01020300) :file-size 160 :block-count 2
                                             :references references)))
    (flexi-streams:with-output-to-sequence (output)
      (emit-octets output (encode-record 'header-record header))
      (emit-octets output (make-array 20 :initial-element 0))
      (emit-octets output (encode-record 'block-record (cl-nintendo-ware.test::make-block-record :magic #.(coerce "DATA" 'simple-base-string) :size data-size)))
      (emit-octets output body)
      (emit-octets output (make-array (- 24 (length body)) :initial-element 0))
      (emit-octets output (encode-record 'block-record (cl-nintendo-ware.test::make-block-record :magic #.(coerce "LABL" 'simple-base-string) :size 64)))
      (emit-octets output (encode-record 'reference-table (cl-nintendo-ware.test::make-reference-table :count 1
                                             :entries (vector (cl-nintendo-ware.test::make-reference :type #x5100 :offset 12)))))
      (emit-octets output (encode-record 'label-entry (cl-nintendo-ware.test::make-label-entry :target (cl-nintendo-ware.test::make-reference :type #x1f00 :offset label-offset)
                                                                :length 5 :name #.(coerce "start" 'simple-base-string))))
      (emit-octets output (make-array 26 :initial-element 0)))))

(defmacro rejects (condition &body body)
  `(assert (handler-case (progn ,@body nil) (,condition () t))))

(defun sound-wave-encoded-size (codec sample-count)
  "The number of encoded bytes for one CWAV channel, excluding alignment."
  (ecase codec
    (0 sample-count)
    (1 (* 2 sample-count))
    (2 (* 8 (ceiling sample-count 14)))
    (3 (ceiling sample-count 2))))

(defun run-tests ()
  (let* ((bytes (sequence-fixture #(60 100 #x81 0 #xe1 1 #x2c #xa0 #xc3 #xff #xf4 0 12 #xf0 #x80 3 #xff #xfe #xff)))
         (sequence (nintendo-ware:read-file :auto bytes))
         (note (nintendo-ware:read-command sequence 0))
         (tempo (nintendo-ware:read-command sequence 4))
         (random (nintendo-ware:read-command sequence 7))
         (extended (nintendo-ware:read-command sequence 13))
         (label (aref (nintendo-ware:sound-sequence-labels-entries (nintendo-ware:sound-sequence-labels sequence)) 0)))
    (assert (= #x01020300 (nintendo-ware:header-version (nintendo-ware:sound-sequence-header sequence))))
    (assert (string= "start" (nintendo-ware:label-entry-name label)))
    (assert (= 0 (nintendo-ware:reference-offset (nintendo-ware:label-entry-target label))))
    (assert (equalp #(0 0 0 0 0) (subseq (nintendo-ware:sound-sequence-data-bytes (nintendo-ware:sound-sequence-data sequence)) 19)))
    (assert (= 60 (nintendo-ware:sequence-command-opcode note)))
    (assert (= 100 (nintendo-ware:note-arguments-velocity (nintendo-ware:sequence-command-arguments note))))
    (assert (= 128 (nintendo-ware:sequence-vlq-value (nintendo-ware:note-arguments-duration (nintendo-ware:sequence-command-arguments note)))))
    (assert (= 300 (nintendo-ware:sequence-command-arguments tempo)))
    (assert (= -12 (nintendo-ware:random-arguments-minimum (nintendo-ware:sequence-command-arguments random))))
    (assert (= 12 (nintendo-ware:random-arguments-maximum (nintendo-ware:sequence-command-arguments random))))
    (assert (eq :transpose (nintendo-ware:sequence-command-name (nintendo-ware:sequence-command-nested random))))
    (assert (= #xf0 (nintendo-ware:sequence-command-opcode extended)))
    (assert (= #x80 (nintendo-ware:sequence-command-extension extended)))
    (assert (= 3 (nintendo-ware:variable-arguments-variable (nintendo-ware:sequence-command-arguments extended))))
    (assert (= -2 (nintendo-ware:variable-arguments-value (nintendo-ware:sequence-command-arguments extended))))
    (assert (equalp sequence (nintendo-ware:read-file :bcseq (flexi-streams:make-in-memory-input-stream bytes))))
    (rejects nintendo-ware:invalid-file (nintendo-ware:read-file :sound-wave bytes))
    (rejects nintendo-ware:invalid-file (nintendo-ware:read-file :auto (subseq bytes 0 159)))
    (rejects nintendo-ware:invalid-file (nintendo-ware:read-file :sound-sequence (sequence-fixture #(#xff) :data-offset 140)))
    (rejects nintendo-ware:invalid-file (nintendo-ware:read-file :sound-sequence (sequence-fixture #(#xff) :header-size 43)))
    (rejects nintendo-ware:invalid-file (nintendo-ware:read-file :sound-sequence (sequence-fixture #(#xff) :label-offset 24))))
  (let ((bytes (sequence-fixture #(#xff))))
    (rotatef (aref bytes 4) (aref bytes 5))
    (rejects nintendo-ware:invalid-file (nintendo-ware:read-file :auto bytes)))
  (dolist (case '((#(0) 0) (#(#x7f) 127) (#(#x81 0) 128) (#(#xff #x7f) 16383)
                  (#(#x81 #x80 0) 16384) (#(#xff #xff #x7f) 2097151) (#(#xff #xff #xff #x7f) 268435455)))
    (destructuring-bind (encoded expected) case
      (let* ((sequence (nintendo-ware:read-file :sound-sequence (sequence-fixture (concatenate 'vector #(#x80) encoded #(#xff)))))
             (command (nintendo-ware:read-command sequence 0)))
        (assert (= expected (nintendo-ware:sequence-vlq-value (nintendo-ware:sequence-command-arguments command))))
        (assert (eq :finish (nintendo-ware:sequence-command-name (nintendo-ware:read-command sequence (nintendo-ware:sequence-command-next-offset command))))))))
  (dolist (case '((#(#xa0 60 100 #xff #xf4 0 12 #xff) :random :note)
                  (#(#xa1 #xf0 #x80 3 2 #xff) :variable :set-variable)
                  (#(#xa2 #xc1 90 #xff) :if :volume)
                  (#(#xa3 60 100 1 0 24 #xff) :time :note)
                  (#(#xa4 #xe1 0 120 0 1 0 2 #xff) :time-random :tempo)
                  (#(#xa5 #xc0 64 4 #xff) :time-variable :pan)))
    (destructuring-bind (body name nested-name) case
      (let* ((sequence (nintendo-ware:read-file :sound-sequence (sequence-fixture body)))
             (command (nintendo-ware:read-command sequence 0)))
        (assert (eq name (nintendo-ware:sequence-command-name command)))
        (assert (eq nested-name (nintendo-ware:sequence-command-name (nintendo-ware:sequence-command-nested command))))
        (assert (eq :finish (nintendo-ware:sequence-command-name (nintendo-ware:read-command sequence (nintendo-ware:sequence-command-next-offset command))))))))
  (let ((sequence (nintendo-ware:read-file :sound-sequence (sequence-fixture #(60 100 #x81) :padded nil))))
    (rejects nintendo-ware:invalid-file (nintendo-ware:read-command sequence 0)))
  (let ((sequence (nintendo-ware:read-file :sound-sequence (sequence-fixture #(#x80 #x80 #x80 #x80 #x80)))))
    (rejects nintendo-ware:invalid-file (nintendo-ware:read-command sequence 0)))
  (let ((sequence (nintendo-ware:read-file :sound-sequence (sequence-fixture #(#x82)))))
    (handler-case (progn (nintendo-ware:read-command sequence 0) (error "Unknown opcode accepted"))
      (nintendo-ware:unknown-opcode (condition)
        (assert (= 0 (nintendo-ware:unknown-opcode-offset condition)))
        (assert (equalp #(#x82) (nintendo-ware:unknown-opcode-raw-bytes condition))))))
  (format t "Direct SEQ graph scenarios passed.~%"))
