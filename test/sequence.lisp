(defbinstruct xbnk-adshr-curve ()
  (attack 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (decay 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (sustain 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (hold 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (release 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (padding (make-array 3 :element-type '(unsigned-byte 8) :initial-element 0)
           :type (simple-array (unsigned-byte 8) (3))))

(defbinstruct xbnk-index-data ()
  (count 0 :type (satisfies (unsigned-byte 32)
                          (lambda (count)
                            (and (<= count 128)
                                 (count-fits-p count 9 (+ 4 (mod (- count) 4)))))))
  (upper-bounds (make-array 0 :element-type '(unsigned-byte 8))
                :type (simple-array (unsigned-byte 8) (count)))
  (padding (make-array 0 :element-type '(unsigned-byte 8))
           :type (simple-array (unsigned-byte 8) ((mod (- count) 4))))
  (references #() :type (simple-array reference (count))))

(defbinstruct xbnk-range-data ()
  (minimum 0 :type (satisfies (unsigned-byte 8) (rcurry #'<= 127)))
  (maximum 0 :type (satisfies (unsigned-byte 8)
                            (lambda (value)
                              (and (<= minimum value 127)
                                   (count-fits-p (1+ (- value minimum)) 8)))))
  (padding 0 :type (unsigned-byte 16))
  (references #() :type (simple-array reference ((1+ (- maximum minimum))))))

