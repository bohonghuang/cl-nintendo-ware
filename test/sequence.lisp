(defpackage #:cl-nintendo-ware.test
  (:use #:cl #:parsonic #:binstruct)
  (:export #:run-tests #:run-format-tests #:run-archive-tests #:run-endian-tests))
(in-package #:cl-nintendo-ware.test)
(defvar *record-start* 0)
(defvar *record-limit* most-positive-fixnum)
(defun count-fits-p (count stride &optional (prefix 4))
  (<= (+ prefix (* count stride)) (- *record-limit* *record-start*)))

(defbinstruct reference ()
  (type 0 :type (unsigned-byte 16))
  (padding 0 :type (unsigned-byte 16))
  (offset -1 :type (signed-byte 32)))

(defbinstruct sized-reference ()
  (type 0 :type (unsigned-byte 16))
  (padding 0 :type (unsigned-byte 16))
  (offset -1 :type (signed-byte 32))
  (size 0 :type (unsigned-byte 32)))

(defbinstruct reference-table ()
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (count-fits-p count 8))))
  (entries #() :type (simple-array reference (count))))

(defbinstruct sized-reference-table ()
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (count-fits-p count 12))))
  (entries #() :type (simple-array sized-reference (count))))

(defbinstruct integer-table ()
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (count-fits-p count 4))))
  (entries #.(make-array 0 :element-type '(unsigned-byte 32)) :type (simple-array (unsigned-byte 32) (count))))

(defbinstruct wave-id ()
  (archive-id 0 :type (unsigned-byte 32))
  (index 0 :type (unsigned-byte 32)))

(defbinstruct wave-id-table ()
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (count-fits-p count 8))))
  (entries #() :type (simple-array wave-id (count))))

(defbinstruct flag-values ()
  (mask 0 :type (unsigned-byte 32))
  (values #.(make-array 0 :element-type '(unsigned-byte 32)) :type (simple-array (unsigned-byte 32) ((logcount mask)))))

(defbinstruct reference-pair ()
  (first (make-reference) :type reference)
  (second (make-reference) :type reference))

(defbinstruct reference-triple ()
  (first (make-reference) :type reference)
  (second (make-reference) :type reference)
  (third (make-reference) :type reference))

(defbinstruct byte-payload (count)
  (bytes #.(make-array 0 :element-type '(unsigned-byte 8)) :type (simple-array (unsigned-byte 8) (count))))

(defbinstruct stream-byte-table ()
  (count 0 :type (unsigned-byte 32))
  (entries #.(make-array 0 :element-type '(unsigned-byte 8)) :type (simple-array (unsigned-byte 8) (count))))


(defbinstruct fixed-text (count)
  (text #.(coerce "" 'simple-base-string) :type (simple-base-string count)))

(defbinstruct terminated-text ()
  (text #.(coerce "" 'simple-base-string) :type simple-base-string))

(defbinstruct header-record ()
  (magic #.(coerce "" 'simple-base-string) :type (simple-base-string 4))
  (bom 0 :type (satisfies (unsigned-byte 16) (lambda (value) (= value #xfeff))))
  (header-size 0 :type (unsigned-byte 16))
  (version 0 :type (unsigned-byte 32))
  (file-size 0 :type (unsigned-byte 32))
  (block-count 0 :type (satisfies (unsigned-byte 16) (lambda (count) (count-fits-p count 12 20))))
  (padding 0 :type (unsigned-byte 16))
  (references #() :type (simple-array sized-reference (block-count))))

(defbinstruct block-record ()
  (magic #.(coerce "" 'simple-base-string) :type (simple-base-string 4))
  (size 0 :type (unsigned-byte 32)))

(defbinstruct label-entry ()
  ($label-start 0 :type position)
  (target (make-reference) :type reference)
  (length 0 :type (satisfies (unsigned-byte 32)
                            (lambda (count) (<= (+ $label-start 13 count) *record-limit*))))
  (name #.(coerce "" 'simple-base-string) :type (simple-base-string length))
  (nil 0 :type (satisfies (unsigned-byte 8))))

(defbinstruct dsp-adpcm-context ()
  (predictor-scale 0 :type (unsigned-byte 16))
  (history-1 0 :type (signed-byte 16))
  (history-2 0 :type (signed-byte 16)))

(defbinstruct dsp-adpcm-info ()
  (coefficients (make-array 16 :element-type '(signed-byte 16) :initial-element 0)
                :type (simple-array (signed-byte 16) (16)))
  (initial-context (make-dsp-adpcm-context) :type dsp-adpcm-context)
  (loop-context (make-dsp-adpcm-context) :type dsp-adpcm-context)
  (padding 0 :type (unsigned-byte 16)))

(defbinstruct ima-adpcm-context ()
  (predictor 0 :type (signed-byte 16))
  (step-index 0 :type (satisfies (unsigned-byte 8) (lambda (value) (<= value 88))))
  (padding 0 :type (unsigned-byte 8)))

(defbinstruct ima-adpcm-info ()
  (initial-context (make-ima-adpcm-context) :type ima-adpcm-context)
  (loop-context (make-ima-adpcm-context) :type ima-adpcm-context))

(defbinstruct sound-wave-info ()
