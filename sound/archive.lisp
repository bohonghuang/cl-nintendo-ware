(in-package #:cl-nintendo-ware)

(defbinstruct/me sound-archive-patricia-node (upper)
  (leaf-flag 0 :type (unsigned-byte 16))
  (bit-index 0 :type (unsigned-byte 16))
  (left-index 0 :type (unsigned-byte 32))
  (right-index 0 :type (unsigned-byte 32))
  (string-index 0 :type (unsigned-byte 32))
  (resource-id 0 :type (unsigned-byte 32)))

(defbinstruct/me sound-archive-sound-3d-info (upper)
  (flags 0 :type (unsigned-byte 32))
  (attenuation-rate 0.0 :type single-float)
  (attenuation-curve 0 :type (unsigned-byte 8))
  (doppler-factor 0 :type (unsigned-byte 8))
  (padding 0 :type (unsigned-byte 16))
  (options (make-flag-values) :type (flag-values upper)))

(defbinstruct/me sound-archive-wave-sound-info (upper)
  (item-index 0 :type (unsigned-byte 32))
  (allocate-track-count 0 :type (unsigned-byte 32))
  (flags (make-flag-values) :type (flag-values upper)))

(defbinstruct/me sound-archive-stream-sound-info (upper)
  (allocate-track-flags 0 :type (unsigned-byte 16))
  (channel-count 0 :type (unsigned-byte 16))
  (flags (make-flag-values) :type (flag-values upper)))

(defbinstruct/me sound-archive-wave-archive (upper)
  (file-id 0 :type (unsigned-byte 32))
  (load-individually 0 :type (unsigned-byte 8))
  (padding #.(make-array 0 :element-type '(unsigned-byte 8)) :type (simple-array (unsigned-byte 8) (3)))
  (flags (make-flag-values) :type (flag-values upper)))

(defbinstruct/me sound-archive-group (upper)
  (file-id 0 :type (unsigned-byte 32))
  (flags (make-flag-values) :type (flag-values upper)))

(defbinstruct/me sound-archive-player (upper)
  (sound-limit 0 :type (unsigned-byte 32))
  (flags (make-flag-values) :type (flag-values upper)))

(defbinstruct/me sound-archive-project-info (upper)
  (maximum-sequences 0 :type (unsigned-byte 16))
  (maximum-sequence-tracks 0 :type (unsigned-byte 16))
  (maximum-stream-sounds 0 :type (unsigned-byte 16))
  (maximum-stream-tracks 0 :type (unsigned-byte 16))
  (maximum-stream-channels 0 :type (unsigned-byte 16))
  (maximum-wave-sounds 0 :type (unsigned-byte 16))
  (maximum-wave-tracks 0 :type (unsigned-byte 16))
  (stream-buffer-times 0 :type (unsigned-byte 8))
  (padding 0 :type (unsigned-byte 8))
  (options 0 :type (unsigned-byte 32)))

(defbinstruct/me sound-archive-patricia-tree (upper)
  (%start 0 :type position)
  (root-index 0 :type (unsigned-byte 32))
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= (+ %start 8 (* 20 count)) upper))))
  (nodes #() :type (simple-array (sound-archive-patricia-node upper) (count))))

(defbinstruct/me sound-archive-string (base upper)
  (reference (make-sized-reference) :type sized-reference)
  (text #.(coerce "" 'simple-base-string)
        :type (peek (simple-base-string (sized-reference-size reference))
                    (sized-reference-target reference base 0 upper #x1f01))))

(defbinstruct/me sound-archive-string-table (upper)
  ($strings-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= (+ $strings-start 4 (* 12 count)) upper))))
  (entries #() :type (simple-array (sound-archive-string $strings-start upper) (count))))

(define-nintendo-ware-section (sound-archive-strg (:magic "STRG"))
    (upper)
  ($strg-start 0 :type position)
  (strings nil :type (reference-to #x2400 $strg-start (bounded upper 4 (sound-archive-string-table upper))))
  (tree nil :type (reference-to #x2401 $strg-start (bounded upper 8 (sound-archive-patricia-tree upper)))))

(defbinstruct/me sound-archive-sequence-info (upper)
  ($sequence-start 0 :type position)
  (banks nil :type (reference-to #x0100 $sequence-start (bounded upper 4 (integer-table upper))))
  (allocate-track-flags 0 :type (unsigned-byte 32))
  (%flags-start 0 :type position)
  (flags (make-flag-values) :type (flag-values upper))
  (start-offset nil :type (ecase (logbitp 0 (flag-values-mask flags))
                            ((nil) null) ((t) (peek (unsigned-byte 32) (flag-position flags 0 %flags-start)))))
  (priority nil :type (ecase (logbitp 1 (flag-values-mask flags))
                        ((nil) null) ((t) (peek packed-priority
                                               (flag-position flags 1 %flags-start))))))

(defbinstruct/me sound-archive-sound (upper)
  (%start 0 :type position)
  (file-id 0 :type (unsigned-byte 32)) (player-id 0 :type (unsigned-byte 32))
  (volume 0 :type (unsigned-byte 8)) (remote-filter 0 :type (signed-byte 8))
  (padding 0 :type (unsigned-byte 16))
  (detail-reference (make-reference) :type reference)
  (flags (make-flag-values) :type (flag-values upper))
  (detail nil :type (ecase (reference-type detail-reference)
                      (#x2203 (peek (sound-archive-sequence-info upper)
                                    (reference-target detail-reference %start 0 upper #x2203 16)))
                      (#x2202 (peek (sound-archive-wave-sound-info upper)
                                    (reference-target detail-reference %start 0 upper #x2202 12)))
                      (#x2201 (peek (sound-archive-stream-sound-info upper)
                                    (reference-target detail-reference %start 0 upper #x2201 8)))))
  (sound-3d-info nil :type (ecase (not (null (flag-target flags 8 %start 0 upper)))
                             ((nil) null) ((t) (peek (sound-archive-sound-3d-info upper)
                                                    (flag-target flags 8 %start 0 upper))))))

(defbinstruct/me sound-archive-wave-sound-group (upper)
  ($group-start 0 :type position)
  (wave-archives nil :type (reference-to #x0100 $group-start (bounded upper 4 (integer-table upper))))
  (flags (make-flag-values) :type (flag-values upper)))

(defbinstruct/me sound-archive-sound-group (upper)
  ($group-start 0 :type position)
  (first-id 0 :type (unsigned-byte 32)) (last-id 0 :type (unsigned-byte 32))
  (files nil :type (reference-to #x0100 $group-start (bounded upper 4 (integer-table upper))))
  (wave-group nil :type (reference-to #x2205 $group-start (bounded upper 12 (sound-archive-wave-sound-group upper))))
  (flags (make-flag-values) :type (flag-values upper)))

(defbinstruct/me sound-archive-bank (upper)
  ($bank-start 0 :type position)
  (file-id 0 :type (unsigned-byte 32))
  (wave-archives nil :type (reference-to #x0100 $bank-start (bounded upper 4 (integer-table upper))))
  (flags (make-flag-values) :type (flag-values upper)))

(defbinstruct/me bounded-string (upper)
  (text #.(coerce "" 'simple-base-string) :type simple-base-string)
  (%end 0 :type (satisfies position (lambda (end) (<= end upper)))))

(defbinstruct/me sound-archive-internal-file (data-lower data-upper)
  (reference (make-sized-reference) :type sized-reference)
  (content nil :type (ecase (= (sized-reference-offset reference) -1)
                      ((t) null)
                      ((nil) (peek (bounded-file (+ (sized-reference-target reference (+ data-lower 8) (+ data-lower 8) data-upper #x1f00)
                                                    (sized-reference-size reference)))
                                   (sized-reference-target reference (+ data-lower 8) (+ data-lower 8) data-upper #x1f00))))))

(defbinstruct/me sound-archive-file (upper data-lower data-upper)
  (%start 0 :type position)
  (location-reference (make-reference) :type reference)
  (flags (make-flag-values) :type (flag-values upper))
  (location nil :type (ecase (= (reference-offset location-reference) -1)
                        ((t) null)
                        ((nil) (ecase (reference-type location-reference)
                                 (#x220c (peek (sound-archive-internal-file data-lower data-upper)
                                               (reference-target location-reference %start 0 upper #x220c 12)))
                                 (#x220d (peek (bounded-string upper)
                                               (reference-target location-reference %start 0 upper #x220d 1))))))))

(defbinstruct/me sound-archive-sounds-table (upper)
  ($table-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= (+ $table-start 4 (* 8 count)) upper))))
  (entries #() :type (simple-array (reference-to #x2200 $table-start (bounded upper 4 (sound-archive-sound upper))) (count))))

(defbinstruct/me sound-archive-sound-groups-table (upper)
  ($table-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= (+ $table-start 4 (* 8 count)) upper))))
  (entries #() :type (simple-array (reference-to #x2204 $table-start (bounded upper 4 (sound-archive-sound-group upper))) (count))))

(defbinstruct/me sound-archive-banks-table (upper)
  ($table-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= (+ $table-start 4 (* 8 count)) upper))))
  (entries #() :type (simple-array (reference-to #x2206 $table-start (bounded upper 4 (sound-archive-bank upper))) (count))))

(defbinstruct/me sound-archive-wave-archives-table (upper)
  ($table-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= (+ $table-start 4 (* 8 count)) upper))))
  (entries #() :type (simple-array (reference-to #x2207 $table-start (bounded upper 4 (sound-archive-wave-archive upper))) (count))))

(defbinstruct/me sound-archive-groups-table (upper)
  ($table-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= (+ $table-start 4 (* 8 count)) upper))))
  (entries #() :type (simple-array (reference-to #x2208 $table-start (bounded upper 4 (sound-archive-group upper))) (count))))

(defbinstruct/me sound-archive-players-table (upper)
  ($table-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= (+ $table-start 4 (* 8 count)) upper))))
  (entries #() :type (simple-array (reference-to #x2209 $table-start (bounded upper 4 (sound-archive-player upper))) (count))))

(defbinstruct/me sound-archive-files-table (upper data-lower data-upper)
  ($table-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= (+ $table-start 4 (* 8 count)) upper))))
  (entries #() :type (simple-array (reference-to #x220a $table-start (bounded upper 4 (sound-archive-file upper data-lower data-upper))) (count))))

(define-nintendo-ware-section (sound-archive-info (:magic "INFO"))
    (upper data-lower data-upper)
  ($info-start 0 :type position)
  (sounds nil :type (reference-to #x2100 $info-start (bounded upper 4 (sound-archive-sounds-table upper))))
  (sound-groups nil :type (reference-to #x2104 $info-start (bounded upper 4 (sound-archive-sound-groups-table upper))))
  (banks nil :type (reference-to #x2101 $info-start (bounded upper 4 (sound-archive-banks-table upper))))
  (wave-archives nil :type (reference-to #x2103 $info-start (bounded upper 4 (sound-archive-wave-archives-table upper))))
  (groups nil :type (reference-to #x2105 $info-start (bounded upper 4 (sound-archive-groups-table upper))))
  (players nil :type (reference-to #x2102 $info-start (bounded upper 4 (sound-archive-players-table upper))))
  (files nil :type (reference-to #x2106 $info-start (bounded upper 4 (sound-archive-files-table upper data-lower data-upper))))
  (project-info nil :type (reference-to #x2107 $info-start (bounded upper 20 (sound-archive-project-info upper)))))

(define-nintendo-ware-file (sound-archive (:magic ("CSAR" "FSAR")))
  (strg nil :type (ecase (not (null (block-reference header #x2000 nil))) ((nil) null) ((t) (peek (sound-archive-strg (block-end header #x2000)) (block-start header #x2000)))))
  (info nil :type (peek (sound-archive-info (block-end header #x2001) (if (block-reference header #x2002 nil) (block-start header #x2002) 0) (if (block-reference header #x2002 nil) (block-end header #x2002) 0)) (block-start header #x2001)))
  (file nil :type (ecase (not (null (block-reference header #x2002 nil)))
                     ((nil) null)
                     ((t) (peek (raw-block "FILE" (sized-reference-size (block-reference header #x2002)))
                                (block-start header #x2002))))))

