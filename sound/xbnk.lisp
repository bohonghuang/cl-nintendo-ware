(in-package #:cl-nintendo-ware)

(defbinstruct/me xbnk-adshr-curve ()
  (attack 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (decay 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (sustain 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (hold 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (release 127 :type (satisfies (signed-byte 8) (lambda (value) (not (minusp value)))))
  (padding (make-array 3 :element-type '(unsigned-byte 8) :initial-element 0)
           :type (simple-array (unsigned-byte 8) (3))))

(defbinstruct xbnk-key-flag ()
  (value 60 :type (signed-byte 8))
  (nil 0 :type (unsigned-byte 24)))

(defbinstruct (xbnk-key-flag/be (:type xbnk-key-flag) (:endian :big)) ()
  (nil 0 :type (unsigned-byte 24))
  (value 60 :type (signed-byte 8)))

(defbinalias xbnk-key-flag/le () xbnk-key-flag)
(%define-endian-reader xbnk-key-flag)

(defbinstruct xbnk-volume-flag ()
  (value 127 :type (unsigned-byte 8))
  (nil 0 :type (unsigned-byte 24)))

(defbinstruct (xbnk-volume-flag/be (:type xbnk-volume-flag) (:endian :big)) ()
  (nil 0 :type (unsigned-byte 24))
  (value 127 :type (unsigned-byte 8)))

(defbinalias xbnk-volume-flag/le () xbnk-volume-flag)
(%define-endian-reader xbnk-volume-flag)

(defbinstruct xbnk-pan-flag ()
  (pan 64 :type (signed-byte 8))
  (surround-pan 0 :type (signed-byte 8))
  (nil 0 :type (unsigned-byte 16)))

(defbinstruct (xbnk-pan-flag/be (:type xbnk-pan-flag) (:endian :big)) ()
  (nil 0 :type (unsigned-byte 16))
  (surround-pan 0 :type (signed-byte 8))
  (pan 64 :type (signed-byte 8)))

(defbinalias xbnk-pan-flag/le () xbnk-pan-flag)
(%define-endian-reader xbnk-pan-flag)

(defbinstruct xbnk-note-flag ()
  (percussion 0 :type (unsigned-byte 8))
  (key-group 0 :type (unsigned-byte 8))
  (interpolation-type 0 :type (unsigned-byte 8))
  (nil 0 :type (unsigned-byte 8)))

(defbinstruct (xbnk-note-flag/be (:type xbnk-note-flag) (:endian :big)) ()
  (nil 0 :type (unsigned-byte 8))
  (interpolation-type 0 :type (unsigned-byte 8))
  (key-group 0 :type (unsigned-byte 8))
  (percussion 0 :type (unsigned-byte 8)))

(defbinalias xbnk-note-flag/le () xbnk-note-flag)
(%define-endian-reader xbnk-note-flag)

(defbinstruct/me xbnk-velocity (wave-count)
  (%start 0 :type position)
  (wave-index 0 :type (satisfies (unsigned-byte 32) (lambda (index) (< index wave-count))))
  (%flags-start 0 :type position)
  (flags (make-flag-values) :type flag-values)
  (key-info nil :type (ecase (logbitp 0 (flag-values-mask flags))
                        ((nil) null)
                        ((t) (peek xbnk-key-flag
                                   (flag-position flags 0 %flags-start)))))
  (volume-info nil :type (ecase (logbitp 1 (flag-values-mask flags))
                        ((nil) null)
                        ((t) (peek xbnk-volume-flag
                                   (flag-position flags 1 %flags-start)))))
  (pan-info nil :type (ecase (logbitp 2 (flag-values-mask flags))
                        ((nil) null)
                        ((t) (peek xbnk-pan-flag
                                   (flag-position flags 2 %flags-start)))))
  (note-info nil :type (ecase (logbitp 4 (flag-values-mask flags))
                        ((nil) null)
                        ((t) (peek xbnk-note-flag
                                   (flag-position flags 4 %flags-start)))))
  (pitch nil :type (ecase (logbitp 3 (flag-values-mask flags))
                     ((nil) null) ((t) (peek single-float (flag-position flags 3 %flags-start)))))
  (envelope nil :type (ecase (not (null (flag-target flags 9 %start)))
                        ((nil) null)
                        ((t) (peek (reference-to 0 (flag-target flags 9 %start) (xbnk-adshr-curve))
                                   (flag-target flags 9 %start))))))

(defbinstruct/me xbnk-velocity-direct (wave-count)
  ($table-start 0 :type position)
  (entry nil :type (reference-to #x5902 $table-start (xbnk-velocity wave-count))))

(defbinstruct/me xbnk-velocity-index (wave-count)
  ($table-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= count 128))))
  (upper-bounds #.(make-array 0 :element-type '(unsigned-byte 8)) :type (simple-array (unsigned-byte 8) (count)))
  (padding #.(make-array 0 :element-type '(unsigned-byte 8)) :type (simple-array (unsigned-byte 8) ((mod (- count) 4))))
  (entries #() :type (simple-array (reference-to #x5902 $table-start (xbnk-velocity wave-count)) (count))))

(defbinstruct/me xbnk-velocity-range (wave-count)
  ($table-start 0 :type position)
  (minimum 0 :type (unsigned-byte 8))
  (maximum 0 :type (satisfies (unsigned-byte 8) (lambda (maximum) (<= minimum maximum 127))))
  (padding 0 :type (unsigned-byte 16))
  (entries #() :type (simple-array (reference-to #x5902 $table-start (xbnk-velocity wave-count)) ((1+ (- maximum minimum))))))

(defbinstruct/me xbnk-key (wave-count)
  (%start 0 :type position)
  (reference (make-reference) :type reference)
  (definition nil :type (ecase (= (reference-offset reference) -1)
                          ((t) null)
                          ((nil) (ecase (reference-type reference)
                                   (#x6000 (peek (xbnk-velocity-direct wave-count)
                                                 (reference-target reference %start #x6000)))
                                   (#x6001 (peek (xbnk-velocity-index wave-count)
                                                 (reference-target reference %start #x6001)))
                                   (#x6002 (peek (xbnk-velocity-range wave-count)
                                                 (reference-target reference %start #x6002))))))))

(defbinstruct/me xbnk-key-direct (wave-count)
  ($table-start 0 :type position)
  (entry nil :type (reference-to #x5901 $table-start (xbnk-key wave-count))))

(defbinstruct/me xbnk-key-index (wave-count)
  ($table-start 0 :type position)
  (count 0 :type (satisfies (unsigned-byte 32) (lambda (count) (<= count 128))))
  (upper-bounds #.(make-array 0 :element-type '(unsigned-byte 8)) :type (simple-array (unsigned-byte 8) (count)))
  (padding #.(make-array 0 :element-type '(unsigned-byte 8)) :type (simple-array (unsigned-byte 8) ((mod (- count) 4))))
  (entries #() :type (simple-array (reference-to #x5901 $table-start (xbnk-key wave-count)) (count))))

(defbinstruct/me xbnk-key-range (wave-count)
  ($table-start 0 :type position)
  (minimum 0 :type (unsigned-byte 8))
  (maximum 0 :type (satisfies (unsigned-byte 8) (lambda (maximum) (<= minimum maximum 127))))
  (padding 0 :type (unsigned-byte 16))
  (entries #() :type (simple-array (reference-to #x5901 $table-start (xbnk-key wave-count)) ((1+ (- maximum minimum))))))

(defbinstruct/me xbnk-instrument (wave-count)
  (%start 0 :type position)
  (reference (make-reference) :type reference)
  (definition nil :type (ecase (= (reference-offset reference) -1)
                          ((t) null)
                          ((nil) (ecase (reference-type reference)
                                   (#x6000 (peek (xbnk-key-direct wave-count)
                                                 (reference-target reference %start #x6000)))
                                   (#x6001 (peek (xbnk-key-index wave-count)
                                                 (reference-target reference %start #x6001)))
                                   (#x6002 (peek (xbnk-key-range wave-count)
                                                 (reference-target reference %start #x6002))))))))

(defbinstruct/me xbnk-instrument-table (wave-count)
  ($table-start 0 :type position)
  (count 0 :type (unsigned-byte 32))
  (entries #() :type (simple-array (reference-to #x5900 $table-start (xbnk-instrument wave-count)) (count))))

(define-nintendo-ware-section (xbnk-info (:magic "INFO"))
  ($info-start 0 :type position)
  (waves-reference (make-reference) :type reference)
  (instruments-reference (make-reference) :type reference)
  (waves nil :type (ecase (= (reference-offset waves-reference) -1)
                     ((t) null)
                     ((nil) (peek wave-id-table
                                  (reference-target waves-reference $info-start #x0100)))))
  (instruments nil :type (ecase (= (reference-offset instruments-reference) -1)
                           ((t) null)
                           ((nil) (peek (xbnk-instrument-table (if waves (wave-id-table-count waves) 0))
                                        (reference-target instruments-reference $info-start #x0101))))))

(define-nintendo-ware-file (xbnk (:magic ("CBNK" "FBNK")))
  (info nil :type (peek xbnk-info (block-start header #x5800))))

